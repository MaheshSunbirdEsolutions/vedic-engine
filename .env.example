# Single root `.env` shared by both `vedic_engine` (Python) and `web` (Next.js).
# Copy this file to `.env` in the repository root and fill in your values.
# Leave Clerk/Supabase unset for local offline SQLite mode.

# --- Next.js Proxy ---
# Local standalone override (on Vercel, ENGINE_URL is injected by vercel.json)
ENGINE_URL=http://127.0.0.1:8000

# --- Clerk ---
# Found in Clerk Dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional: comma-separated allowed `azp` origins (e.g. http://localhost:3000)
CLERK_AUTHORIZED_PARTIES=
# Used for dev testing scripts / backend calls (never commit `.env`)
CLERK_SECRET_KEY=sk_test_...
# Required only when receiving Clerk webhooks on POST /webhooks/clerk
CLERK_WEBHOOK_SECRET=

# --- Supabase ---
# Found in Supabase Dashboard -> Integrations -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# Found in Supabase Dashboard -> Configuration -> API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Set to "false" only if you explicitly want to run without auth locally
# even when other variables are present (ignored on Vercel).
# AUTH_REQUIRED=true
