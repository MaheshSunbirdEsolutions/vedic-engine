{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "engine": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "vedic_engine.api:app",
      "functions": {
        "**/*.py": {
          "excludeFiles": "{web/**,tests/**,tools/**,sources/**,*.md,*.bat,*.sh}"
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "engine",
          "format": "url",
          "env": "ENGINE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
